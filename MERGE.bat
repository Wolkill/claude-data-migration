@echo off
chcp 65001 >nul
setlocal

rem ============================================================
rem  Вливание собранных данных В ЭТУ машину.
rem  Сначала пробный прогон, потом подтверждение, потом запись.
rem  Перед запуском Claude должен быть ПОЛНОСТЬЮ закрыт.
rem ============================================================

cd /d "%~dp0"

if not exist "claude-evac" (
    echo.
    echo   Папка claude-evac не найдена.
    echo.
    echo   Распакуй сюда claude-evac.zip со старой машины, чтобы получилось:
    echo       %~dp0claude-evac\claude\projects\...
    echo.
    pause
    exit /b 1
)

echo.
echo ============================================================
echo   ШАГ 1 из 2: пробный прогон ^(ничего не меняется^)
echo ============================================================
echo.

powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp02-merge.ps1" -DryRun
if errorlevel 1 (
    echo.
    echo   Пробный прогон завершился с ошибкой. Записи не было.
    echo.
    pause
    exit /b 1
)

echo.
echo ============================================================
echo   ШАГ 2 из 2: применить изменения?
echo ============================================================
echo.
echo   Выше показано, что будет добавлено.
echo   Перед изменениями будет создан бэкап текущего состояния.
echo.
set "ANSWER="
set /p "ANSWER=  Применить? Введи ДА и нажми Enter (любой другой ответ - отмена): "

if /i not "%ANSWER%"=="ДА" (
    echo.
    echo   Отменено. Ничего не изменено.
    echo.
    pause
    exit /b 0
)

echo.
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp02-merge.ps1"
set "RC=%errorlevel%"

echo.
if not "%RC%"=="0" (
    echo ============================================================
    echo   Слияние НЕ выполнено — причина указана выше.
    echo   Данные не изменены. Устрани причину и запусти снова.
    echo ============================================================
    echo.
    pause
    exit /b %RC%
)

echo ============================================================
echo   Готово. Дальше: запусти Claude, войди в аккаунт
echo   и проверь историю командой  claude --resume
echo   в любой из перенесённых папок.
echo ============================================================
echo.
pause
