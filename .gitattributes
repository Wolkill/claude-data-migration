# cmd.exe неправильно разбирает .bat с LF-переводами строк:
# ломаются блоки if(...), переменные оказываются пустыми, куски строк
# выполняются как команды. Фиксируем CRLF независимо от настроек клиента.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# PowerShell 5.1 читает .ps1 без BOM как ANSI и портит кириллицу,
# поэтому файлы хранятся в UTF-8 с BOM — не даём git их нормализовать.
*.ps1  -text

*.py   text eol=lf
*.md   text eol=lf
